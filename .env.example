PORT=3000

# Aceitar qualquer loja (false = só as lojas da lista)
ALLOW_ANY_STORE=false

# Moeda usada quando a página não informa
DEFAULT_CURRENCY=USD

# Taxas de câmbio para Kwanzas (atualize regularmente)
RATE_USD_AOA=912
RATE_EUR_AOA=1000
RATE_GBP_AOA=1170

# Para lojas que bloqueiam (Amazon, Temu, SHEIN, Nike, Zara...):
# Opção 1 - serviço anti-bot (recomendado em produção)
SCRAPER_API_KEY=

# Opção 2 - navegador headless (npm i puppeteer)
USE_BROWSER=false
